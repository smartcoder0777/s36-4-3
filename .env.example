# Copy to .env and fill in your values
# In sandbox: OPENAI_BASE_URL is set by validator gateway; OPENAI_API_KEY from your config

# Local development - use your OpenAI key
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override model
OPENAI_MODEL=gpt-4o-mini

# Sandbox: validator sets OPENAI_BASE_URL to gateway (e.g. http://sandbox-gateway:9000/openai)
# OPENAI_BASE_URL=http://sandbox-gateway:9000/openai

# Agent behavior (optional)
# AGENT_MAX_STEPS=10
# AGENT_MAX_TOOL_CALLS=2
# AGENT_USE_TASK_KNOWLEDGE=0
# AGENT_TASK_KNOWLEDGE_PATH=/path/to/baseline_actions.json
# AGENT_ENABLE_LOOP_BREAKER=1
# AGENT_ENABLE_SAME_CLICK_GUARD=1
